{
	"compilerOptions": {
		"target": "es2025",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"outDir": "dist",
		"noEmit": true,
		"declaration": true,
		"strict": true,
		"allowSyntheticDefaultImports": true,
		"sourceMap": true,
		"paths": {
			"@typings": ["./src/shared/typings.ts"],
			"@shared/*": ["./src/shared/*"],
			"@feature/*": ["./src/features/*"],
			"@utility/*": ["./src/utility/*"],
			"@src/*": ["./src/*"]
		},
		"typeRoots": ["node"]
	},
	"include": ["src", "dev", "tests", "vitest.config.ts", "tsup.config.ts", "eslint.config.mjs"],
	"exclude": ["node_modules", "dist"]
}
